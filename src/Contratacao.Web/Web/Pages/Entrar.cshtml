@page
@model EntrarModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutPublico";
}

@if (Model.Conectado is { } nome)
{
    <div class="alert alert-info">
        <div class="mb-2">Você já está conectado como <strong>@nome</strong>.</div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/" class="btn btn-sm btn-primary">Continuar</a>
            <form method="post" asp-page="/Sair">
                <button type="submit" class="btn btn-sm btn-outline-primary">Sair e entrar com outra conta</button>
            </form>
        </div>
    </div>
}

<h2 class="mb-1">Entrar</h2>
<p class="text-body-secondary mb-4">Use seu e-mail @@ucl.br e a senha do sistema.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Entrada.Email" class="form-label">E-mail</label>
        <input asp-for="Entrada.Email" type="email" class="form-control form-control-lg" placeholder="nome@ucl.br" autocomplete="username" autofocus />
        <span asp-validation-for="Entrada.Email" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Entrada.Senha" class="form-label">Senha</label>
        <input asp-for="Entrada.Senha" class="form-control form-control-lg" autocomplete="current-password" />
        <span asp-validation-for="Entrada.Senha" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Entrar</button>
</form>

<p class="text-center mt-4 mb-0">
    Ainda não tem acesso? <a href="/Cadastro" class="fw-semibold">Cadastre-se como Solicitante</a>
</p>
