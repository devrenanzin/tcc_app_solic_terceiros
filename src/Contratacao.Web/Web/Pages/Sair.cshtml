@page
@model SairModel
@{
    ViewData["Title"] = "Sair";
    Layout = "_LayoutPublico";
}

<h2 class="mb-1">Sair do sistema</h2>
<p class="text-body-secondary mb-4">
    Você está conectado como <strong>@Model.Nome</strong><br />
    <span class="small">@Model.Email</span>
</p>

<form method="post" asp-page="/Sair">
    <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-box-arrow-right"></i> Sair agora</button>
</form>
<a href="/" class="btn btn-light btn-lg w-100 mt-2">Continuar conectado</a>
