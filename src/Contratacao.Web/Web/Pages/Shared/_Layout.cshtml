@using System.Security.Claims
@using Contratacao.Web.Domain.Usuarios
@{
    var nome = User.Identity?.Name ?? string.Empty;
    var iniciais = string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var perfil = Enum.TryParse<Perfil>(User.FindFirstValue(ClaimTypes.Role), out var p) ? p : (Perfil?)null;
    var caminho = Context.Request.Path.Value ?? "/";
    string Ativo(string prefixo) => (prefixo == "/" ? caminho == "/" : caminho.StartsWith(prefixo, StringComparison.OrdinalIgnoreCase)) ? "ativo" : string.Empty;
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Contratação</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
</head>
<body>
    <div class="barra-movel">
        <button type="button" class="btn btn-sm text-white" aria-label="Abrir menu"
                onclick="document.getElementById('menu').classList.toggle('aberto')">
            <i class="bi bi-list fs-4"></i>
        </button>
        <span class="fw-semibold">Sistema de Contratação</span>
        <a href="/Sair" class="btn btn-sm text-white ms-auto" aria-label="Sair"><i class="bi bi-box-arrow-right fs-5"></i></a>
    </div>

    <div class="app">
        <nav id="menu" class="menu-lateral" aria-label="Menu principal">
            <a class="marca" href="/"><i class="bi bi-briefcase-fill" aria-hidden="true"></i> Contratação</a>

            <ul class="nav flex-column">
                <li><a class="nav-link @Ativo("/")" href="/"><i class="bi bi-house-door"></i> Início</a></li>
            </ul>

            <div class="titulo-grupo">Demandas</div>
            <ul class="nav flex-column">
                @if (perfil == Perfil.Solicitante)
                {
                    <li><a class="nav-link @Ativo("/Demandas/Nova")" href="/Demandas/Nova"><i class="bi bi-file-earmark-plus"></i> Nova demanda</a></li>
                }
                <li>
                    <a class="nav-link @(caminho.StartsWith("/Demandas", StringComparison.OrdinalIgnoreCase) && !caminho.StartsWith("/Demandas/Nova", StringComparison.OrdinalIgnoreCase) ? "ativo" : string.Empty)" href="/Demandas">
                        <i class="bi bi-kanban"></i> @(perfil == Perfil.Solicitante ? "Minhas demandas" : "Demandas")
                    </a>
                </li>
            </ul>

            @if (perfil == Perfil.Admin)
            {
                <div class="titulo-grupo">Administração</div>
                <ul class="nav flex-column">
                    <li><a class="nav-link @Ativo("/Admin/Gestores")" href="/Admin/Gestores"><i class="bi bi-person-badge"></i> Gestores</a></li>
                    <li><a class="nav-link @Ativo("/Admin/GerentesExecutivos")" href="/Admin/GerentesExecutivos"><i class="bi bi-person-lines-fill"></i> Gerentes executivos</a></li>
                    <li><a class="nav-link @Ativo("/Admin/OrdensServico")" href="/Admin/OrdensServico"><i class="bi bi-journal-text"></i> OS dos contratos</a></li>
                    <li><a class="nav-link @Ativo("/Admin/FuncionariosSesi")" href="/Admin/FuncionariosSesi"><i class="bi bi-people-fill"></i> Funcionários SESI</a></li>
                    <li><a class="nav-link @Ativo("/Admin/Transferencias")" href="/Admin/Transferencias"><i class="bi bi-arrow-left-right"></i> Transferir vínculo</a></li>
                    <li><a class="nav-link @Ativo("/Solicitantes")" href="/Solicitantes"><i class="bi bi-people"></i> Solicitantes</a></li>
                </ul>
            }
            @if (perfil == Perfil.Gestor)
            {
                <div class="titulo-grupo">Gestão</div>
                <ul class="nav flex-column">
                    <li><a class="nav-link @Ativo("/Equipe")" href="/Equipe"><i class="bi bi-people-fill"></i> Equipe SESI</a></li>
                    <li><a class="nav-link @Ativo("/Solicitantes")" href="/Solicitantes"><i class="bi bi-people"></i> Solicitantes</a></li>
                </ul>
            }

            <div class="rodape-menu">
                <div class="usuario-logado">
                    <div class="avatar" aria-hidden="true">@iniciais</div>
                    <div>
                        <div class="nome">@nome</div>
                        <div class="perfil">@(perfil is { } valor ? Contratacao.Web.Web.Formatacao.Perfil(valor) : string.Empty)</div>
                    </div>
                </div>
                @* asp-page: o formulário leva o token antifalsificação, sem o qual o POST é recusado. *@
                <form method="post" asp-page="/Sair">
                    <button type="submit" class="nav-link w-100 border-0 bg-transparent"><i class="bi bi-box-arrow-right"></i> Sair</button>
                </form>
            </div>
        </nav>

        <main class="conteudo">
            <partial name="_Mensagens" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
