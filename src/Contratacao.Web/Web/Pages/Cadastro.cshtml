@page
@using Contratacao.Web.Domain.Usuarios
@model CadastroModel
@{
    ViewData["Title"] = "Cadastrar-se";
    Layout = "_LayoutPublico";
}

<h2 class="mb-1">Cadastre-se</h2>
<p class="text-body-secondary mb-4">Crie seu acesso de Solicitante com o e-mail @@ucl.br.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Entrada.Nome" class="form-label">Nome completo</label>
        <input asp-for="Entrada.Nome" class="form-control" autocomplete="name" autofocus />
        <span asp-validation-for="Entrada.Nome" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Email" class="form-label">E-mail</label>
        <input asp-for="Entrada.Email" type="email" class="form-control" placeholder="nome@ucl.br" autocomplete="email" />
        <span asp-validation-for="Entrada.Email" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label asp-for="Entrada.Senha" class="form-label">Senha</label>
            <input asp-for="Entrada.Senha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Entrada.Senha" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Entrada.ConfirmacaoSenha" class="form-label">Confirme a senha</label>
            <input asp-for="Entrada.ConfirmacaoSenha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Entrada.ConfirmacaoSenha" class="text-danger small"></span>
        </div>
        <div class="col-12 ajuda">Mínimo de @Senha.TamanhoMinimo caracteres.</div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Criar acesso</button>
</form>

<p class="text-center mt-4 mb-0">Já tem acesso? <a href="/Entrar" class="fw-semibold">Entrar</a></p>
