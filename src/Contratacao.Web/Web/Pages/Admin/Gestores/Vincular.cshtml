@page
@using Contratacao.Web.Web.Pages.Shared
@model Contratacao.Web.Web.Pages.Admin.Gestores.VincularModel
@{
    ViewData["Title"] = "Vincular conta como Gestor";
}

<div class="cabecalho-pagina">
    <div>
        <a href="/Admin/Gestores" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Gestores</a>
        <h1 class="mt-1">Vincular conta existente</h1>
        <p>Transforma uma conta já cadastrada em Gestor do Contrato, sem criar conta nova.</p>
    </div>
</div>

<form method="post" class="cartao formulario" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <partial name="_AvisoVinculo" model="@("Gestor do Contrato")" />

    <div class="mb-3">
        <label class="form-label" for="email">E-mail da conta</label>
        <input id="email" name="Email" type="email" value="@Model.Email" class="form-control" placeholder="nome@ucl.br" required autofocus />
    </div>

    <fieldset class="mb-4">
        <legend class="form-label fs-6">Contratos</legend>
        <partial name="_EscolhaContratos" model="new EscolhaContratos(Model.ContratosDisponiveis, Model.Contratos, nameof(Model.Contratos), true)" />
    </fieldset>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-link-45deg"></i> Vincular conta</button>
        <a href="/Admin/Gestores" class="btn btn-light">Cancelar</a>
    </div>
</form>
