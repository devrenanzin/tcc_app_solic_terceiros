@page
@using Contratacao.Web.Web.Pages.Shared
@model Contratacao.Web.Web.Pages.Admin.GerentesExecutivosModel
@{
    ViewData["Title"] = "Gerentes executivos";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Gerentes executivos</h1>
        <p>Cada gerente atende um ou mais corredores; no formulário, o Solicitante só vê os gerentes do corredor escolhido. Nada é excluído: o desativado sai da lista.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <form method="post" class="cartao formulario" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <label class="form-label" for="nome">Novo gerente executivo</label>
            <input id="nome" name="Nome" value="@Model.Nome" maxlength="150" class="form-control" required />
            <fieldset class="mt-3">
                <legend class="form-label fs-6">Corredores que atende</legend>
                <partial name="_CorredoresGerente" model="new EscolhaCorredores(Model.CorredoresDisponiveis, Model.Corredores, Model.PrefixoNovo)" />
            </fieldset>
            <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-plus-lg"></i> Cadastrar</button>
        </form>
    </div>
    <div class="col-lg-8">
        <div class="cartao">
            @if (Model.Gerentes.Count == 0)
            {
                <div class="vazio"><i class="bi bi-person-lines-fill"></i>Nenhum gerente cadastrado. Sem eles, o Solicitante não consegue enviar demandas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table tabela-cartao">
                        <thead><tr><th>Nome</th><th>Corredores</th><th>Situação</th><th class="text-end">Ações</th></tr></thead>
                        <tbody>
                            @foreach (var gerente in Model.Gerentes)
                            {
                                var marcados = gerente.Corredores.Select(c => c.CorredorId).ToList();
                                <tr>
                                    <td class="fw-semibold">@gerente.Nome</td>
                                    <td>
                                        @foreach (var corredor in marcados.Select(Model.NomeCorredor).Order())
                                        {
                                            <span class="etiqueta-contrato">@corredor</span>
                                        }
                                        <details class="mt-1">
                                            <summary class="small">Alterar corredores</summary>
                                            <form method="post" asp-page-handler="Corredores" asp-route-id="@gerente.Id" class="mt-2">
                                                <partial name="_CorredoresGerente" model="new EscolhaCorredores(Model.CorredoresDisponiveis, marcados, gerente.Id.ToString())" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary mt-2">Salvar corredores</button>
                                            </form>
                                        </details>
                                    </td>
                                    <td><partial name="_SituacaoUsuario" model="gerente.Ativo" /></td>
                                    <td class="text-end"><partial name="_AcaoSituacao" model="new AcaoSituacao(gerente.Id, gerente.Ativo, gerente.Nome)" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
