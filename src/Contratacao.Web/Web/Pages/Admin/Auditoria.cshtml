@page
@model Contratacao.Web.Web.Pages.Admin.AuditoriaModel
@{
    ViewData["Title"] = "Auditoria";
    var r = Model.Resultado;
}

<div class="cabecalho-pagina">
    <div>
        <h1>Auditoria</h1>
        <p>Log geral: cadastros, vínculos, parâmetros, anexos, cancelamentos e operações excepcionais. Nada aqui é alterado nem excluído.</p>
    </div>
</div>

<form method="get" class="cartao filtros">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label" for="entidade">Entidade</label>
            <select id="entidade" name="Entidade" class="form-select form-select-sm">
                <option value="">Todas</option>
                @foreach (var entidade in r.Entidades)
                {
                    <option value="@entidade" selected="@(Model.Entidade == entidade)">@entidade</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="acao">Ação contém</label>
            <input id="acao" name="Acao" value="@Model.Acao" class="form-control form-control-sm" placeholder="Ex.: OperacaoExcepcional" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="de">De</label>
            <input id="de" name="De" type="date" value="@Model.De?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="ate">Até</label>
            <input id="ate" name="Ate" type="date" value="@Model.Ate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel"></i> Filtrar</button>
            <a href="/Admin/Auditoria" class="btn btn-sm btn-light">Limpar</a>
        </div>
    </div>
</form>

<p class="resumo-lista"><strong>@r.Total</strong> registros · página @r.Pagina de @Model.TotalPaginas</p>

<div class="cartao">
    @if (r.Registros.Count == 0)
    {
        <div class="vazio"><i class="bi bi-journal"></i>Nenhum registro com esses filtros.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tabela-cartao tabela-auditoria">
                <thead>
                    <tr><th>Quando</th><th>Quem</th><th>Entidade</th><th>Ação</th><th>Antes</th><th>Depois</th><th>Justificativa</th></tr>
                </thead>
                <tbody>
                    @foreach (var registro in r.Registros)
                    {
                        <tr>
                            <td class="small text-nowrap">@Formatacao.DataHora(registro.DataHora)</td>
                            <td class="small">
                                <div class="fw-semibold">@(registro.Usuario ?? "Sistema")</div>
                                <div class="text-body-secondary">@registro.PerfilUsuario@(registro.EnderecoIp is { } ip ? $" · {ip}" : string.Empty)</div>
                            </td>
                            <td class="small">
                                @registro.Entidade
                                @if (registro.Entidade == "Demanda" && registro.EntidadeId is { } demanda)
                                {
                                    <div><a href="/Demandas/Detalhe/@demanda">abrir demanda</a></div>
                                }
                            </td>
                            <td class="small fw-semibold">@registro.Acao</td>
                            <td class="small valor-log">@(registro.ValorAnterior ?? "—")</td>
                            <td class="small valor-log">@(registro.NovoValor ?? "—")</td>
                            <td class="small">@(registro.Justificativa ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPaginas > 1)
{
    <nav class="d-flex justify-content-center gap-2 mt-3" aria-label="Páginas">
        @if (r.Pagina > 1)
        {
            <a class="btn btn-sm btn-light" href="/Admin/Auditoria@(Model.Link(r.Pagina - 1))"><i class="bi bi-chevron-left"></i> Anterior</a>
        }
        @if (r.Pagina < Model.TotalPaginas)
        {
            <a class="btn btn-sm btn-light" href="/Admin/Auditoria@(Model.Link(r.Pagina + 1))">Próxima <i class="bi bi-chevron-right"></i></a>
        }
    </nav>
}
